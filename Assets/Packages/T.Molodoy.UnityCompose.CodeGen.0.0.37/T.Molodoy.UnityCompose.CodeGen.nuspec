<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>T.Molodoy.UnityCompose.CodeGen</id>
    <version>0.0.37</version>
    <authors>T. Molodoy</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <description>Code generator for Unity Compose.</description>
    <repository type="git" url="https://github.com/tmolodoy671games/Unity-Compose-CodeGen" commit="f056fefe443228be3d79af2a83f0deb2c742d3f7" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.CodeAnalysis.CSharp" version="4.14.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.CodeAnalysis.Common" version="4.14.0" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="9.0.9" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>